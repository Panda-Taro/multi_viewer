[Unit]
Description=MultiViewer FFmpeg compositor (4-split / single, format alarm)
Documentation=https://github.com/Panda-Taro/multi_viewer
After=multiviewer-mtl-rx.service
Requires=multiviewer-mtl-rx.service

[Service]
Type=simple
User=multiviewer
Environment=MTL_RX_CONFIG=/etc/multiviewer/mtl/rx_config.json
Environment=MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554/monitor01
ExecStart=/opt/multiviewer/compositor/compose.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
