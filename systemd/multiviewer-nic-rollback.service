[Unit]
Description=MultiViewer NIC rollback safety check (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=MULTIVIEWER_CONFIG_DIR=/etc/multiviewer
Environment=MULTIVIEWER_LOG_DIR=/var/log/multiviewer
Environment=MULTIVIEWER_NETPLAN_DIR=/etc/netplan
ExecStart=/opt/multiviewer/venv/bin/python /opt/multiviewer/nic_rollback_check.py
User=root
