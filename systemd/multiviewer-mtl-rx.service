[Unit]
Description=MultiViewer MTL ST2110-20/-30 RX (video x4, audio x1, ST2022-7)
Documentation=https://github.com/Panda-Taro/multi_viewer
After=network-online.target multiviewer-hugepages.service
Wants=network-online.target
Requires=multiviewer-hugepages.service

[Service]
Type=simple
User=root
Environment=MTL_RX_CONFIG=/etc/multiviewer/mtl/rx_config.json
Environment=PTP_DOMAIN=24
ExecStart=/opt/multiviewer/mtl/scripts/start_rx.sh
Restart=on-failure
RestartSec=3
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
