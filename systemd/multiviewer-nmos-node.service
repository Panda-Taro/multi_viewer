[Unit]
Description=MultiViewer nmos-cpp Node (IS-04 Node/Registration client, IS-05 Connection API)
Documentation=https://github.com/sony/nmos-cpp
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
Type=simple
User=multiviewer
WorkingDirectory=/opt/multiviewer/build/nmos-cpp
ExecStart=/opt/multiviewer/build/nmos-cpp/Development/build/nmos-cpp-node/nmos-cpp-node /etc/multiviewer/nmos/node_config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
