[Unit]
Description=MultiViewer WebGUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/multiviewer/webgui
Environment=MULTIVIEWER_CONFIG_DIR=/etc/multiviewer
Environment=MULTIVIEWER_LOG_DIR=/var/log/multiviewer
Environment=MULTIVIEWER_NETPLAN_DIR=/etc/netplan
ExecStart=/opt/multiviewer/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
# The WebGUI writes netplan files and triggers reboots, so it needs root.
User=root

[Install]
WantedBy=multi-user.target
