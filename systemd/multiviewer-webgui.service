[Unit]
Description=MultiViewer WebGUI (/mgmt/, /monitor01/)
Documentation=https://github.com/Panda-Taro/multi_viewer
After=network-online.target multiviewer-mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=multiviewer
WorkingDirectory=/opt/multiviewer/webgui
ExecStart=/opt/multiviewer/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
