[Unit]
Description=Periodically check for an unconfirmed NIC IP change to roll back

[Timer]
# Runs shortly after boot and then every 20s thereafter. This is
# deliberately always-on (not just while a change is pending): it must
# survive a WebGUI crash or an unexpected reboot and still catch an
# unconfirmed change, and the check itself is a cheap no-op when nothing
# is pending (see nic_ip_change.perform_rollback_if_expired).
OnBootSec=20s
OnUnitActiveSec=20s
AccuracySec=1s

[Install]
WantedBy=multi-user.target
